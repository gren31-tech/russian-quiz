<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📖"
                android:textSize="48sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Русский язык"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/blue_primary"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Тесты для школьников"
                android:textSize="16sp"
                android:textColor="@color/gray_text"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Total Score Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/blue_primary"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tv_total_score"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Общий счёт: 0 очков"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:padding="20dp"/>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Выбери тест:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/dark_text"
            android:layout_marginBottom="12dp"/>

        <!-- Test 1 Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔤"
                        android:textSize="28sp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Тест 1: Алфавит и буквы"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark_text"/>

                        <TextView
                            android:id="@+id/tv_score1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Не пройден"
                            android:textSize="13sp"
                            android:textColor="@color/gray_text"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_test1"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Начать тест"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/blue_primary"
                    android:textColor="@android:color/white"
                    style="@style/Widget.MaterialComponents.Button"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Test 2 Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎵"
                        android:textSize="28sp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Тест 2: Гласные и согласные"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark_text"/>

                        <TextView
                            android:id="@+id/tv_score2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Не пройден"
                            android:textSize="13sp"
                            android:textColor="@color/gray_text"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_test2"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Начать тест"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/purple_primary"
                    android:textColor="@android:color/white"
                    style="@style/Widget.MaterialComponents.Button"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Test 3 Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✏️"
                        android:textSize="28sp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Тест 3: Правила написания"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark_text"/>

                        <TextView
                            android:id="@+id/tv_score3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Не пройден"
                            android:textSize="13sp"
                            android:textColor="@color/gray_text"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_test3"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Начать тест"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/green_score"
                    android:textColor="@android:color/white"
                    style="@style/Widget.MaterialComponents.Button"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Test 4 Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📝"
                        android:textSize="28sp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Тест 4: Части речи"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark_text"/>

                        <TextView
                            android:id="@+id/tv_score4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Не пройден"
                            android:textSize="13sp"
                            android:textColor="@color/gray_text"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_test4"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Начать тест"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/orange_warning"
                    android:textColor="@android:color/white"
                    style="@style/Widget.MaterialComponents.Button"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Test 5 Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💬"
                        android:textSize="28sp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Тест 5: Предложения"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark_text"/>

                        <TextView
                            android:id="@+id/tv_score5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Не пройден"
                            android:textSize="13sp"
                            android:textColor="@color/gray_text"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_test5"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Начать тест"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/red_wrong"
                    android:textColor="@android:color/white"
                    style="@style/Widget.MaterialComponents.Button"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
